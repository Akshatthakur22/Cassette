generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DATABASE_URL_UNPOOLED")
}

model Tape {
  id                String      @id @default(cuid())
  publicId          String      @unique
  draftToken        String      @unique
  title             String?
  dedication        String?
  senderName        String
  recipientName     String?
  relationship      String?     // partner | best_friend | family | memory | self | other
  style             String      @default("classic") // classic | y2k | love | road_trip | school | summer
  visibility        String      @default("unlisted") // unlisted | public
  memoryDate        DateTime?
  status            String      @default("draft")   // draft | published | deleted
  flaggedForReview  Boolean     @default(false)     // Auto-flagged after 3+ content reports
  createdFromTapeId String?     // For viral loop: ID of tape this was created from
  
  // Playlist metadata (optional, for playlists created from YouTube)
  playlistSourceId  String?     // YouTube playlist ID if created from playlist
  playlistSourceUrl String?     // Original YouTube playlist URL
  playlistName      String?     // Original playlist name from YouTube
  
  // Voice message (optional)
  voiceMessageUrl   String?     // S3/storage URL for voice file
  voiceMessageSize  Int?        // File size in bytes
  voiceMessageDuration Int?     // Duration in seconds
  voiceMessageMimeType String?  // audio/webm, audio/mp3, etc
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?
  tracks            TapeTrack[]
  views             TapeView[]
  shareEvents       ShareEvent[]
  contentReports    ContentReport[]

  // Indexes for critical lookups
  @@index([publicId])
  @@index([draftToken])
  @@index([status])
  @@index([visibility])
  @@index([deletedAt])
}

model TapeTrack {
  id              String   @id @default(cuid())
  tapeId          String
  tape            Tape     @relation(fields: [tapeId], references: [id], onDelete: Cascade)
  side            String   // "A" | "B"
  position        Int
  title           String
  artist          String?
  thumbnailUrl    String?
  provider        String   @default("youtube")
  providerTrackId String
  personalNote    String?
  durationSec     Int?
  createdAt       DateTime @default(now())

  @@index([tapeId])
}

model ShareEvent {
  id        String   @id @default(cuid())
  tapeId    String
  tape      Tape     @relation(fields: [tapeId], references: [id], onDelete: Cascade)
  platform  String   // whatsapp | copy_link | native_share | other
  createdAt DateTime @default(now())

  @@index([tapeId])
}

model TapeView {
  id        String   @id @default(cuid())
  tapeId    String
  tape      Tape     @relation(fields: [tapeId], references: [id], onDelete: Cascade)
  sessionId String
  createdAt DateTime @default(now())

  @@index([tapeId])
  @@index([sessionId])
}

model YoutubeSearchCache {
  id              String   @id @default(cuid())
  query           String   @unique // "title|artist" normalized
  videoId         String
  title           String
  channelTitle    String
  thumbnailUrl    String
  durationSec     Int?
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([expiresAt])
}

model YoutubePlaylistCache {
  id              String   @id @default(cuid())
  playlistId      String   @unique // YouTube playlist ID
  title           String
  description     String?
  thumbnailUrl    String?
  channelTitle    String?
  trackCount      Int
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([expiresAt])
}
model ContentReport {
  id                String   @id @default(cuid())
  tapeId            String
  tape              Tape     @relation(fields: [tapeId], references: [id], onDelete: Cascade)
  reporterSessionId String
  reason            String   // inappropriate | spam | copyright | harassment | other
  details           String?
  status            String   @default("pending") // pending | reviewed | removed
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tapeId])
  @@index([status])
}

enum SongStatus {
  PENDING
  DOWNLOADING
  READY
  FAILED
}

model Song {
  id            String      @id @default(cuid())
  videoId       String      @unique
  title         String
  artist        String?
  thumbnailUrl  String?
  durationSec   Int?
  audioUrl      String?
  audioPath     String?
  mimeType      String?     @default("audio/mp4")
  fileSizeBytes Int?
  status        SongStatus  @default(PENDING)
  errorMessage  String?
  downloadCount Int         @default(0)
  lastPlayedAt  DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([videoId])
  @@index([status])
}
