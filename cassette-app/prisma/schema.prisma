generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DATABASE_URL_UNPOOLED")
}

model Tape {
  id                String      @id @default(cuid())
  publicId          String      @unique
  draftToken        String      @unique
  title             String?
  dedication        String?
  senderName        String
  recipientName     String?
  relationship      String?     // partner | best_friend | family | memory | self | other
  style             String      @default("classic") // classic | y2k | love | road_trip | school | summer
  visibility        String      @default("unlisted") // unlisted | public
  memoryDate        DateTime?
  status            String      @default("draft")   // draft | published | deleted
  flaggedForReview  Boolean     @default(false)     // Auto-flagged after 3+ content reports
  createdFromTapeId String?     // For viral loop: ID of tape this was created from
  
  // Playlist metadata (optional, for playlists created from YouTube)
  playlistSourceId  String?     // YouTube playlist ID if created from playlist
  playlistSourceUrl String?     // Original YouTube playlist URL
  playlistName      String?     // Original playlist name from YouTube
  
  // Voice message (optional)
  voiceMessageUrl   String?     // S3/storage URL for voice file
  voiceMessageSize  Int?        // File size in bytes
  voiceMessageDuration Int?     // Duration in seconds
  voiceMessageMimeType String?  // audio/webm, audio/mp3, etc
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?
  tracks            TapeTrack[]
  views             TapeView[]
  shareEvents       ShareEvent[]
  contentReports    ContentReport[]

  // Indexes for critical lookups
  @@index([publicId])
  @@index([draftToken])
  @@index([status])
  @@index([visibility])
  @@index([deletedAt])
}

model TapeTrack {
  id              String   @id @default(cuid())
  tapeId          String
  tape            Tape     @relation(fields: [tapeId], references: [id], onDelete: Cascade)
  side            String   // "A" | "B"
  position        Int
  title           String
  artist          String?
  thumbnailUrl    String?
  provider        String   @default("youtube") // "youtube" | "voice" | "media_asset"
  providerTrackId String
  personalNote    String?
  durationSec     Int?
  
  // NEW: Direct reference to processed media asset (for provider="media_asset")
  mediaAssetId    String?
  mediaAsset      MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  
  createdAt       DateTime @default(now())

  @@index([tapeId])
  @@index([mediaAssetId])
}

model ShareEvent {
  id        String   @id @default(cuid())
  tapeId    String
  tape      Tape     @relation(fields: [tapeId], references: [id], onDelete: Cascade)
  platform  String   // whatsapp | copy_link | native_share | other
  createdAt DateTime @default(now())

  @@index([tapeId])
}

model TapeView {
  id        String   @id @default(cuid())
  tapeId    String
  tape      Tape     @relation(fields: [tapeId], references: [id], onDelete: Cascade)
  sessionId String
  createdAt DateTime @default(now())

  @@index([tapeId])
  @@index([sessionId])
}

model YoutubeSearchCache {
  id              String   @id @default(cuid())
  query           String   @unique // "title|artist" normalized
  videoId         String
  title           String
  channelTitle    String
  thumbnailUrl    String
  durationSec     Int?
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([expiresAt])
}

model YoutubePlaylistCache {
  id              String   @id @default(cuid())
  playlistId      String   @unique // YouTube playlist ID
  title           String
  description     String?
  thumbnailUrl    String?
  channelTitle    String?
  trackCount      Int
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([expiresAt])
}

// Media asset processing and storage tracking
model MediaAsset {
  id              String   @id @default(cuid())
  
  // Source identification
  provider        String   // "youtube"
  providerTrackId String   // YouTube video ID
  
  // Metadata
  title           String
  artist          String?
  durationSec     Int      // Original duration from source
  
  // Processing state
  status          String   @default("PENDING")
  // Values: PENDING | VALIDATING | DOWNLOADING | CONVERTING | UPLOADING | READY | FAILED | EXPIRED
  
  // Attempt tracking (retries)
  attemptCount    Int      @default(0)
  lastAttemptAt   DateTime?
  nextAttemptAt   DateTime?
  
  // Error tracking
  error           String?  // Last error message (user-friendly)
  errorDetails    String?  // Full technical error details
  
  // Storage
  storageProvider String?  // "r2" (for future multi-cloud support)
  storageKey      String?  // Path/key in R2 bucket: "media-assets/{id}.mp3"
  mimeType        String?  // "audio/mpeg"
  fileSize        Int?     // Bytes
  checksum        String?  // SHA-256 hash for integrity verification
  
  // Playback compatibility
  bitrate         Int?     // kbps (e.g., 128)
  
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  processedAt     DateTime? // When processing completed
  expiresAt       DateTime? // For temp storage cleanup
  
  // Relationships
  tracks          TapeTrack[]
  
  @@index([status])
  @@index([provider, providerTrackId])  // Duplicate prevention
  @@index([expiresAt])
}

model ContentReport {
  id                String   @id @default(cuid())
  tapeId            String
  tape              Tape     @relation(fields: [tapeId], references: [id], onDelete: Cascade)
  reporterSessionId String
  reason            String   // inappropriate | spam | copyright | harassment | other
  details           String?
  status            String   @default("pending") // pending | reviewed | removed
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tapeId])
  @@index([status])
}
